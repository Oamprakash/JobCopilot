# Copy to .env and load it in your shell or run configuration. Every value has a dev default except where noted.
APP_ENV=dev
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/applycopilot
DATABASE_USER=applycopilot
DATABASE_PASSWORD=applycopilot
WEB_BASE_URL=http://localhost:3000
STORAGE_DIR=./data/uploads

# Required in prod (32+ characters). Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional: Claude parses resumes when set; otherwise the built-in heuristic parser runs.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Fit scoring uses a cheaper model than resume parsing.
CLAUDE_SCORING_MODEL=claude-haiku-5-5

# Job feed: boards sync and every feed rebuilds on this interval (in-process scheduler).
INGEST_INTERVAL_HOURS=24
SCHEDULER_ENABLED=true
# Optional: Adzuna job search adds listings from employer career sites that have no public API
# (large product, Fortune 500 and service companies). Free key: https://developer.adzuna.com
# The free key allows 250 calls/day and 2,500/month; commercial use beyond a 14-day trial needs an Adzuna licence.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_DAILY_CALLS=60

# New tailored applications a free user may start per calendar month.
FREE_TAILOR_LIMIT=5
# Comma-separated emails that may use /admin: the dashboard (users, activity, searches) and board management.
ADMIN_EMAILS=
# Activity events behind the admin dashboard are deleted after this many days.
EVENT_RETENTION_DAYS=180

# Required in prod: sends magic-link emails through Resend. In dev, links are logged and shown on the sign-in page.
RESEND_API_KEY=
MAIL_FROM=TrulyApply <login@trulyapply.com>

# Sharing your local app through a public link (e.g. Cloudflare Tunnel): set WEB_BASE_URL to that https link,
# turn this on, and list who may sign in. Admins can always sign in; their links are only printed in this window.
PUBLIC_PREVIEW=false
INVITE_EMAILS=

# The product's name in emails.
APP_NAME=TrulyApply

# Optional: keep uploaded resume files in Cloudflare R2 (or any S3-compatible bucket). Set all four or none.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Daily match email: the hour (0-23) and time zone it goes out in. Users turn it off under Preferences.
DIGEST_HOUR=8
DIGEST_TIMEZONE=Asia/Kolkata
